# ── Servidor ─────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# Sirve la version minificada (public-dist) en vez de public.
# Activarla SOLO en produccion despues de correr `npm run build`.
SERVE_BUILT=0

# ── Secretos (¡CAMBIAR en producción!) ───────────────────
# Se usa por defecto. En Vercel defínela en el panel de Environment Variables.
JWT_SECRET=itc-evaluaciones-secret-2026
REFRESH_SECRET=itc-evaluaciones-refresh-secret-2026
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_IN=7d

# ── Almacenamiento ───────────────────────────────────────
# Si ninguna variable está definida se usa db.json (JSON). Con una conexión se
# usa Postgres automáticamente (tabla kv: bucket, k, value). Se aceptan
# DATABASE_URL o las variables del template de Vercel/Neon (POSTGRES_URL /
# POSTGRES_URL_NON_POOLING).
# DATABASE_URL=postgres://user:pass@host:5432/db

# ── Credenciales iniciales (seed) ────────────────────────
PROFESOR_USER=GKempe
PROFESOR_PASSWORD=1234
PROFESOR_NOMBRE=Gustavo Kempe
ADMIN_USER=admin
ADMIN_PASSWORD=admin123
ADMIN_NOMBRE=Administrador

# ── Valores por defecto de evaluaciones ──────────────────
EVALUACION_DEFAULT_INTENTOS=3
EVALUACION_DEFAULT_PORCENTAJE=60
EVALUACION_DEFAULT_DURACION=15

# ── Seguridad login ──────────────────────────────────────
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MS=900000